source ../Make_ncdf.src
setenv NCDF /cluster/software/netCDF-Fortran/4.6.0-iimpi-2022a
setenv EXTRANCDF -lnetcdff -lnetcdf
/bin/rm -f netcdf.mod libnetcdf.a
/bin/rm -f typesizes.mod
setenv OS `/bin/uname`
/bin/uname
if ( Linux == Linux ) then
if ( `/bin/uname -m` == alpha ) then
/bin/uname -m
if ( `/bin/uname -m` == x86_64 ) then
/bin/uname -m
setenv OS Linux64
endif
setenv OS Linux_Fram
endif
switch ( Linux_Fram )
setenv FC ifort
setenv FFLAGS -g -O3 -convert big_endian
setenv FLIBS -lfftw3 -lnetcdff -lnetcdf 
setenv CC cc
setenv CFLAGS -O
breaksw
foreach f ( hycom_binning_nc hycom_scrip_nc )
if ( ! -e hycom_binning_nc_Linux_Fram ) then
if ( -f `find ${f}.F -prune -newer ${f}_${OS}` ) then
find hycom_binning_nc.F -prune -newer hycom_binning_nc_Linux_Fram
echo hycom_binning_nc_Linux_Fram is already up to date
hycom_binning_nc_Linux_Fram is already up to date
endif
touch hycom_binning_nc
/bin/rm -f hycom_binning_nc
chmod a+rx hycom_binning_nc_Linux_Fram
/bin/ln -s hycom_binning_nc_Linux_Fram hycom_binning_nc
end
