
# Ensure the procesed NC file has a time variable with hourly unit

if [ $# -eq 1 ]; then
   File0=$1
   echo ${File0}
   File1=pre_${File0#*hourly.}   
   File2=pre2_${File0#*hourly.}   
   File3=pre3_${File0#*hourly.}   
   echo ${File1}
   J0=$(datetojul 1970 1 1 1900 1 1)
   (( Jh = $J0 * 24 ))
   if [ ! -s ${File1} ]; then
      ncap2 -h -s "time=${Jh}+valid_time/3600" -s "time@calendar=\"gregorian\"" -s "time@units=\"hours since 1900-01-01 00:00:00\"" ${File0} ${File1}
   fi
   [ ! -s ${File1} ] && { echo "No ${File1}";  exit 1; }
   if [ ! -s ${File2} ]; then
      ncks -Oh -C -x -v valid_time,expver ${File1} ${File2}
   fi
   [ ! -s ${File2} ] && { echo "No ${File2}";  exit 2; }
   ncks -6 ${File2} ${File3}
   [ ! -s ${File3} ] && { echo "No ${File3}";  exit 3; }
   ncrename -Oh -d valid_time,time ${File3}
   ##ncks -Oh -L 4 ${File3} ${File1}
   if [ -r ./hourly ]; then
      ncks -4 -L 4 ${File3} ./hourly/hourly.${File0#*hourly.}
      [ -s ${File2} ] && rm ${File2}
      [ -s ${File1} ] && rm ${File1}
      rm ${File3}
   fi
else
   echo "Missing the input NC file like *hourly.????_yyyy.nc"
   exit 0
fi
